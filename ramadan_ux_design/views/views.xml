<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ramadan_theme_layout" name="Ramadan Theme Elements" inherit_id="website.layout" priority="50">
        <xpath expr="//head" position="inside">
            <style type="text/css">
                <![CDATA[
                /* ===== GOLDEN STARRY SKY ===== */
                .starfield {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    pointer-events: none;
                    z-index: -1;
                    background: radial-gradient(ellipse at 30% 40%, #0a2e28 0%, #020d0b 100%);
                    overflow: hidden;
                }

                .star {
                    position: absolute;
                    background-color: #ffd700;
                    border-radius: 50%;
                    box-shadow: 0 0 10px 2px rgba(255, 215, 0, 0.8);
                    animation: twinkle var(--twinkle-duration) infinite ease-in-out;
                }

                .star.small { width: 2px; height: 2px; }
                .star.medium { width: 3px; height: 3px; box-shadow: 0 0 12px 3px #ffaa00; }
                .star.large { width: 5px; height: 5px; box-shadow: 0 0 18px 5px #ffaa33; }

                .shooting-star {
                    position: absolute;
                    width: 150px;
                    height: 2px;
                    background: linear-gradient(90deg, transparent, #ffd700, transparent);
                    transform: rotate(25deg);
                    filter: blur(1px);
                    animation: shoot 4s linear infinite;
                }

                @keyframes twinkle {
                    0%, 100% { opacity: 0.8; transform: scale(1); }
                    50% { opacity: 0.3; transform: scale(0.8); }
                }

                @keyframes shoot {
                    0% { left: -10%; top: 10%; opacity: 1; }
                    100% { left: 110%; top: 40%; opacity: 0; }
                }

                /* ===== SINGLE CRESCENT MOON ===== */
                .crescent-moon {
                    position: absolute;
                    top: 60px;
                    left: 10%;
                    width: 140px;
                    height: 140px;
                    border-radius: 50%;
                    box-shadow: -25px 15px 0 0 #fff9e6;
                    transform: rotate(-10deg);
                    filter: drop-shadow(0 0 15px #ffd700);
                    z-index: 5;
                    opacity: 0.9;
                }

                /* ===== TRADITIONAL ARABIC LAMPS (FANOUS) ===== */
                .fanous-container {
                    position: absolute;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    transform-origin: top center;
                    z-index: 10;
                    filter: drop-shadow(0 5px 5px rgba(0,0,0,0.5));
                    transition: filter 0.3s ease;
                }
                .fanous-container:hover {
                    filter: drop-shadow(0 0 20px #ffaa00);
                    cursor: pointer;
                }

                /* Chain */
                .fanous-chain {
                    width: 4px;
                    height: 120px;
                    background: repeating-linear-gradient(45deg, #b8860b 0px 4px, #8b6913 4px 8px);
                    box-shadow: 0 0 5px #ffcc33;
                }

                /* Lantern body */
                .fanous {
                    position: relative;
                    width: 60px;
                    height: 90px;
                }

                /* Top dome */
                .fanous-top {
                    position: absolute;
                    top: -15px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 40px;
                    height: 20px;
                    background: linear-gradient(145deg, #c9a44b, #7d5d1a);
                    border-radius: 50% 50% 0 0;
                    border-bottom: 2px solid #ffcc33;
                }

                /* Metal frame (main body) */
                .fanous-body {
                    position: relative;
                    width: 100%;
                    height: 100%;
                    background: #1f2a1a;
                    border: 4px solid #c9a44b;
                    border-radius: 20px 20px 10px 10px;
                    box-shadow: inset 0 0 10px #7d5d1a, 0 5px 10px rgba(0,0,0,0.5);
                    overflow: hidden;
                }

                /* Glass panels (colored) */
                .fanous-glass {
                    position: absolute;
                    top: 8px;
                    left: 8px;
                    right: 8px;
                    bottom: 8px;
                    background: linear-gradient(145deg, #ffaa33, #cc7700);
                    border-radius: 12px 12px 6px 6px;
                    opacity: 0.7;
                    box-shadow: inset 0 0 20px #ffaa00;
                }

                /* Decorative patterns (simple dots) */
                .fanous-pattern {
                    position: absolute;
                    top: 15px;
                    left: 10px;
                    width: 40px;
                    height: 60px;
                    background-image: radial-gradient(circle at 10px 15px, #ffd700 2px, transparent 2px),
                                      radial-gradient(circle at 30px 35px, #ffd700 2px, transparent 2px),
                                      radial-gradient(circle at 20px 50px, #ffd700 2px, transparent 2px);
                    background-size: 40px 40px;
                    opacity: 0.5;
                }

                /* Flame */
                .fanous-flame {
                    position: absolute;
                    bottom: -10px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 8px;
                    height: 15px;
                    background: #ff7700;
                    border-radius: 50% 50% 40% 40%;
                    box-shadow: 0 0 15px #ff5500;
                    animation: flicker 0.2s infinite alternate;
                }

                @keyframes flicker {
                    0% { transform: translateX(-50%) scale(1); opacity: 0.8; }
                    100% { transform: translateX(-50%) scale(1.2); opacity: 1; }
                }

                /* Lamp positions */
                .lamp-1 { left: 5%; top: 15%; animation: swing 5s infinite ease-in-out; }
                .lamp-2 { left: 15%; top: 35%; animation: swing 6s infinite ease-in-out; }
                .lamp-3 { right: 8%; top: 20%; animation: swing 5.5s infinite ease-in-out; }
                .lamp-4 { right: 20%; top: 45%; animation: swing 7s infinite ease-in-out; }
                .lamp-5 { left: 25%; top: 65%; animation: swing 4.5s infinite ease-in-out; }
                .lamp-6 { right: 12%; top: 70%; animation: swing 6.5s infinite ease-in-out; }

                @keyframes swing {
                    0%, 100% { transform: rotate(-2deg); }
                    50% { transform: rotate(2deg); }
                }

                /* ===== MUSIC PLAYER PANEL ===== */
                .music-player-panel {
                    position: fixed;
                    top: 50%;
                    right: -310px;
                    transform: translateY(-50%);
                    display: flex;
                    align-items: center;
                    z-index: 2000;
                    transition: right 0.7s cubic-bezier(0.65, 0, 0.35, 1);
                }
                .music-player-panel.open { right: 0; }

                .panel-toggle {
                    width: 45px;
                    height: 140px;
                    background: linear-gradient(135deg, #d4af37, #b8860b);
                    color: #020d0b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    cursor: pointer;
                    border-radius: 20px 0 0 20px;
                    box-shadow: -8px 0 25px rgba(0,0,0,0.6);
                    border: 1px solid #ffcc33;
                    border-right: none;
                    transition: all 0.3s ease;
                }
                .panel-toggle:hover {
                    background: linear-gradient(135deg, #ffcc33, #d4af37);
                }

                .panel-content {
                    width: 310px;
                    background: rgba(8, 20, 15, 0.95);
                    backdrop-filter: blur(20px);
                    padding: 25px;
                    border-left: 3px solid #d4af37;
                    box-shadow: -15px 0 40px rgba(0,0,0,0.7);
                }

                .play-pause-btn {
                    background: #d4af37;
                    border: none;
                    border-radius: 50%;
                    width: 50px;
                    height: 50px;
                    cursor: pointer;
                    color: #020d0b;
                    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
                    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                }
                .play-pause-btn:hover { 
                    transform: scale(1.15); 
                    background: #ffcc33; 
                }

                .seek-slider { 
                    flex: 1; 
                    accent-color: #d4af37; 
                    cursor: pointer; 
                }

                /* Keep content readable */
                #wrap {
                    position: relative;
                    z-index: 15;
                    background-color: rgba(2,13,11,0.5);
                    border-radius: 20px;
                    margin: 20px;
                    padding: 20px;
                    backdrop-filter: blur(5px);
                }
                ]]>
            </style>
        </xpath>

        <xpath expr="//body" position="inside">
            <!-- Starry Sky -->
            <div class="starfield" id="starfield"></div>

            <!-- Single Crescent -->
            <div class="crescent-moon"></div>

            <!-- Traditional Lamps -->
            <div class="fanous-container lamp-1">
                <div class="fanous-chain"></div>
                <div class="fanous">
                    <div class="fanous-top"></div>
                    <div class="fanous-body">
                        <div class="fanous-glass"></div>
                        <div class="fanous-pattern"></div>
                    </div>
                    <div class="fanous-flame"></div>
                </div>
            </div>
            <div class="fanous-container lamp-2">
                <div class="fanous-chain" style="height:150px;"></div>
                <div class="fanous">
                    <div class="fanous-top"></div>
                    <div class="fanous-body">
                        <div class="fanous-glass"></div>
                        <div class="fanous-pattern"></div>
                    </div>
                    <div class="fanous-flame"></div>
                </div>
            </div>
            <div class="fanous-container lamp-3">
                <div class="fanous-chain" style="height:110px;"></div>
                <div class="fanous">
                    <div class="fanous-top"></div>
                    <div class="fanous-body">
                        <div class="fanous-glass"></div>
                        <div class="fanous-pattern"></div>
                    </div>
                    <div class="fanous-flame"></div>
                </div>
            </div>
            <div class="fanous-container lamp-4">
                <div class="fanous-chain" style="height:180px;"></div>
                <div class="fanous">
                    <div class="fanous-top"></div>
                    <div class="fanous-body">
                        <div class="fanous-glass"></div>
                        <div class="fanous-pattern"></div>
                    </div>
                    <div class="fanous-flame"></div>
                </div>
            </div>
            <div class="fanous-container lamp-5">
                <div class="fanous-chain" style="height:130px;"></div>
                <div class="fanous">
                    <div class="fanous-top"></div>
                    <div class="fanous-body">
                        <div class="fanous-glass"></div>
                        <div class="fanous-pattern"></div>
                    </div>
                    <div class="fanous-flame"></div>
                </div>
            </div>
            <div class="fanous-container lamp-6">
                <div class="fanous-chain" style="height:160px;"></div>
                <div class="fanous">
                    <div class="fanous-top"></div>
                    <div class="fanous-body">
                        <div class="fanous-glass"></div>
                        <div class="fanous-pattern"></div>
                    </div>
                    <div class="fanous-flame"></div>
                </div>
            </div>

            <!-- Music Panel -->
            <div class="music-player-panel" id="musicPlayerPanel">
                <div class="panel-toggle" id="panelToggle">
                    <i class="fa fa-chevron-left" id="toggleIcon" style="transition: transform 0.6s;"></i>
                </div>
                <div class="panel-content">
                    <h5 style="text-align:center; color:#d4af37; margin-bottom:15px;">🌙 RAMADAN KAREEM</h5>
                    <div style="display:flex; align-items:center; gap:15px;">
                        <button class="play-pause-btn" id="playPauseBtn">
                            <i class="fa fa-play"></i>
                        </button>
                        <input type="range" class="seek-slider" id="seekSlider" value="0" step="0.1" min="0"/>
                    </div>
                    <audio id="ramadanSong" loop="loop">
                        <source src="/ramadan_ux_design/static/description/song.mp3" type="audio/mpeg"/>
                    </audio>
                </div>
            </div>
        </xpath>

        <xpath expr="//body" position="after">
            <script type="text/javascript">
                <![CDATA[
                document.addEventListener('DOMContentLoaded', function() {
                    // Stars generation
                    const starfield = document.getElementById('starfield');
                    if (starfield) {
                        for (let i = 0; i < 300; i++) {
                            const star = document.createElement('div');
                            star.className = 'star';
                            const r = Math.random();
                            if (r < 0.6) star.classList.add('small');
                            else if (r < 0.9) star.classList.add('medium');
                            else star.classList.add('large');
                            star.style.left = Math.random() * 100 + '%';
                            star.style.top = Math.random() * 100 + '%';
                            const duration = 2 + Math.random() * 3;
                            star.style.setProperty('--twinkle-duration', duration + 's');
                            starfield.appendChild(star);
                        }
                        for (let i = 0; i < 5; i++) {
                            const shooting = document.createElement('div');
                            shooting.className = 'shooting-star';
                            shooting.style.animationDelay = i * 7 + 's';
                            starfield.appendChild(shooting);
                        }
                    }

                    // Music player
                    const panel = document.getElementById('musicPlayerPanel');
                    const toggle = document.getElementById('panelToggle');
                    const icon = document.getElementById('toggleIcon');
                    const audio = document.getElementById('ramadanSong');
                    const btn = document.getElementById('playPauseBtn');
                    const slider = document.getElementById('seekSlider');

                    toggle.addEventListener('click', () => {
                        panel.classList.toggle('open');
                        icon.style.transform = panel.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0deg)';
                    });

                    btn.addEventListener('click', () => {
                        if (audio.paused) {
                            audio.play().catch(e => console.log("Play blocked"));
                            btn.innerHTML = '<i class="fa fa-pause"></i>';
                        } else {
                            audio.pause();
                            btn.innerHTML = '<i class="fa fa-play"></i>';
                        }
                    });

                    audio.addEventListener('timeupdate', () => {
                        if (!isNaN(audio.duration)) {
                            slider.max = audio.duration;
                            slider.value = audio.currentTime;
                        }
                    });

                    slider.addEventListener('input', () => {
                        audio.currentTime = slider.value;
                    });
                });
                ]]>
            </script>
        </xpath>
    </template>
</odoo>
