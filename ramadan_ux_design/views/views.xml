<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ramadan_theme_layout" name="Ramadan Theme Elements" inherit_id="website.layout" priority="50">
        <xpath expr="//head" position="inside">
            <style type="text/css">
                <![CDATA[
                /* ===== GOLDEN STARRY SKY BACKGROUND ===== */
                .starfield {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    pointer-events: none;
                    z-index: -1;
                    background: radial-gradient(ellipse at 30% 40%, #0a2e28 0%, #020d0b 100%);
                    overflow: hidden;
                }

                .star {
                    position: absolute;
                    background-color: #ffd700;
                    border-radius: 50%;
                    box-shadow: 0 0 10px 2px rgba(255, 215, 0, 0.8);
                    animation: twinkle var(--twinkle-duration) infinite ease-in-out;
                }

                .star.small {
                    width: 2px;
                    height: 2px;
                }
                .star.medium {
                    width: 3px;
                    height: 3px;
                    box-shadow: 0 0 12px 3px #ffaa00;
                }
                .star.large {
                    width: 5px;
                    height: 5px;
                    box-shadow: 0 0 18px 5px #ffaa33;
                }

                .shooting-star {
                    position: absolute;
                    width: 150px;
                    height: 2px;
                    background: linear-gradient(90deg, rgba(255,255,255,0) 0%, #ffd700 50%, rgba(255,255,255,0) 100%);
                    transform: rotate(25deg);
                    filter: blur(1px);
                    animation: shoot 4s linear infinite;
                }

                @keyframes twinkle {
                    0%, 100% { opacity: 0.8; transform: scale(1); }
                    50% { opacity: 0.3; transform: scale(0.8); }
                }

                @keyframes shoot {
                    0% { left: -10%; top: 10%; opacity: 1; }
                    70% { opacity: 1; }
                    100% { left: 110%; top: 40%; opacity: 0; }
                }

                /* ===== ARABIC LAMPS (FANOOS) WITH DEPTH & DETAIL ===== */
                .fanoos-container {
                    position: absolute;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    transform-origin: top center;
                    z-index: 10;
                    filter: drop-shadow(0 10px 8px rgba(0,0,0,0.6));
                    transition: filter 0.3s ease;
                }
                .fanoos-container:hover {
                    filter: drop-shadow(0 0 20px #ffaa00);
                    cursor: pointer;
                }

                /* Chain (more realistic) */
                .fanoos-chain {
                    width: 4px;
                    height: 140px;
                    background: repeating-linear-gradient(
                        45deg,
                        #b8860b 0px, #b8860b 4px,
                        #8b6913 4px, #8b6913 8px
                    );
                    box-shadow: 0 0 5px #ffcc33;
                }

                /* Main lantern body */
                .fanoos {
                    position: relative;
                    width: 70px;
                    height: 110px;
                }

                /* Top metal cap */
                .fanoos-top {
                    position: absolute;
                    top: -25px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 45px;
                    height: 30px;
                    background: linear-gradient(145deg, #c0a050, #7d5d1a);
                    clip-path: polygon(20% 100%, 80% 100%, 100% 50%, 50% 0%, 0% 50%);
                    border-bottom: 3px solid #ffcc33;
                    border-radius: 10px 10px 0 0;
                    box-shadow: inset -2px -2px 5px #3a2e0b, inset 2px 2px 5px #ffeb99;
                }

                /* Main body with glass panels and metal frame */
                .fanoos-body {
                    position: relative;
                    width: 100%;
                    height: 100%;
                    background: #1f2a1a;
                    border: 4px solid #c9a44b;
                    border-radius: 30px 30px 15px 15px;
                    box-shadow: inset 0 0 20px #7d5d1a, 0 10px 15px rgba(0,0,0,0.5);
                    overflow: hidden;
                }

                /* Glass panels with glow */
                .fanoos-body::before {
                    content: '';
                    position: absolute;
                    top: 5%;
                    left: 5%;
                    width: 90%;
                    height: 90%;
                    background: linear-gradient(145deg, #ffeb99, #c9a44b);
                    clip-path: polygon(10% 0%, 90% 0%, 100% 10%, 100% 90%, 90% 100%, 10% 100%, 0% 90%, 0% 10%);
                    opacity: 0.5;
                    box-shadow: inset 0 0 30px #ffaa00;
                }

                /* Decorative patterns (filigree) */
                .fanoos-body::after {
                    content: '';
                    position: absolute;
                    top: 15%;
                    left: 15%;
                    width: 70%;
                    height: 70%;
                    background-image: 
                        radial-gradient(circle at 20% 30%, #ffcc33 2px, transparent 2px),
                        radial-gradient(circle at 80% 70%, #ffcc33 2px, transparent 2px),
                        radial-gradient(circle at 40% 60%, #ffcc33 2px, transparent 2px),
                        radial-gradient(circle at 60% 40%, #ffcc33 2px, transparent 2px);
                    background-size: 20px 20px;
                    opacity: 0.6;
                }

                /* Inner light source (pulsing) */
                .fanoos-glow {
                    position: absolute;
                    bottom: 10px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 30px;
                    height: 30px;
                    background: radial-gradient(circle, #fff7b0 0%, #ffaa33 80%);
                    border-radius: 50%;
                    filter: blur(10px);
                    animation: lanternPulse 3s infinite ease-in-out;
                }

                /* Bottom metal part */
                .fanoos-bottom {
                    position: absolute;
                    bottom: -10px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 40px;
                    height: 15px;
                    background: linear-gradient(145deg, #b8860b, #5e3f0c);
                    border-radius: 50%;
                    box-shadow: inset -2px -2px 5px #2a1f05, inset 2px 2px 5px #ffcc33;
                }

                /* Droplet (flame) */
                .fanoos-droplet {
                    position: absolute;
                    bottom: -22px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 12px;
                    height: 18px;
                    background: #ffaa33;
                    border-radius: 50% 50% 40% 40%;
                    box-shadow: 0 0 20px #ff7700, 0 0 40px #ff5500;
                    animation: flameFlicker 0.3s infinite alternate;
                }

                @keyframes lanternPulse {
                    0%, 100% { opacity: 0.6; filter: blur(10px) brightness(1); }
                    50% { opacity: 1; filter: blur(15px) brightness(1.5); }
                }

                @keyframes flameFlicker {
                    0% { transform: translateX(-50%) scale(1); opacity: 0.8; }
                    100% { transform: translateX(-50%) scale(1.2); opacity: 1; }
                }

                /* Lamp positions with varied chain lengths and swing speeds */
                .lamp-1 { left: 5%; top: 10%; animation: lampSwing 5s infinite ease-in-out; }
                .lamp-2 { left: 15%; top: 25%; animation: lampSwing 6.5s infinite ease-in-out; }
                .lamp-3 { right: 8%; top: 15%; animation: lampSwing 4.8s infinite ease-in-out; }
                .lamp-4 { right: 20%; top: 35%; animation: lampSwing 5.5s infinite ease-in-out; }
                .lamp-5 { left: 25%; top: 55%; animation: lampSwing 7s infinite ease-in-out; }
                .lamp-6 { right: 12%; top: 60%; animation: lampSwing 5.2s infinite ease-in-out; }

                @keyframes lampSwing {
                    0%, 100% { transform: rotate(-2deg); }
                    50% { transform: rotate(2deg); }
                }

                /* Crescent moon (more detailed) */
                .crescent-moon {
                    position: absolute;
                    top: 80px;
                    left: 12%;
                    width: 140px;
                    height: 140px;
                    border-radius: 50%;
                    box-shadow: -25px 15px 0 0 #fff9e6, -30px 20px 20px rgba(255,215,0,0.6);
                    transform: rotate(-10deg);
                    z-index: 5;
                    opacity: 0.9;
                }
                .crescent-moon::after {
                    content: '';
                    position: absolute;
                    top: 10px;
                    left: 10px;
                    width: 120px;
                    height: 120px;
                    border-radius: 50%;
                    background: transparent;
                    box-shadow: 20px -10px 0 5px #ffeb99;
                }

                /* ===== MUSIC PLAYER PANEL (SMOOTH SLIDING) ===== */
                .music-player-panel {
                    position: fixed;
                    top: 50%;
                    right: -310px;
                    transform: translateY(-50%);
                    display: flex;
                    align-items: center;
                    z-index: 2000;
                    transition: right 0.7s cubic-bezier(0.65, 0, 0.35, 1);
                }

                .music-player-panel.open {
                    right: 0;
                }

                .panel-toggle {
                    width: 45px;
                    height: 140px;
                    background: linear-gradient(135deg, #d4af37, #b8860b);
                    color: #020d0b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    cursor: pointer;
                    border-radius: 20px 0 0 20px;
                    box-shadow: -8px 0 25px rgba(0,0,0,0.6);
                    border: 1px solid #ffcc33;
                    border-right: none;
                    transition: all 0.3s ease;
                }

                .panel-toggle:hover {
                    background: linear-gradient(135deg, #ffcc33, #d4af37);
                }

                .panel-content {
                    width: 310px;
                    background: rgba(8, 20, 15, 0.95);
                    backdrop-filter: blur(20px);
                    padding: 25px;
                    border-left: 3px solid #d4af37;
                    box-shadow: -15px 0 40px rgba(0,0,0,0.7);
                }

                .play-pause-btn {
                    background: #d4af37;
                    border: none;
                    border-radius: 50%;
                    width: 50px;
                    height: 50px;
                    cursor: pointer;
                    color: #020d0b;
                    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
                    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                }

                .play-pause-btn:hover { 
                    transform: scale(1.15); 
                    background: #ffcc33; 
                }

                .seek-slider { 
                    flex: 1; 
                    accent-color: #d4af37; 
                    cursor: pointer; 
                }

                /* Ensure website content remains readable */
                #wrap {
                    position: relative;
                    z-index: 15;
                    background-color: rgba(2,13,11,0.5);
                    border-radius: 20px;
                    margin: 20px;
                    padding: 20px;
                    backdrop-filter: blur(5px);
                }
                ]]>
            </style>
        </xpath>

        <xpath expr="//body" position="inside">
            <!-- Starry Golden Sky -->
            <div class="starfield" id="starfield"></div>

            <!-- Crescent Moon -->
            <div class="crescent-moon"></div>

            <!-- Arabic Lamps (Fanoos) - six lamps with depth -->
            <div class="fanoos-container lamp-1">
                <div class="fanoos-chain"></div>
                <div class="fanoos">
                    <div class="fanoos-top"></div>
                    <div class="fanoos-body"></div>
                    <div class="fanoos-glow"></div>
                    <div class="fanoos-bottom"></div>
                    <div class="fanoos-droplet"></div>
                </div>
            </div>
            <div class="fanoos-container lamp-2">
                <div class="fanoos-chain" style="height:180px;"></div>
                <div class="fanoos">
                    <div class="fanoos-top"></div>
                    <div class="fanoos-body"></div>
                    <div class="fanoos-glow"></div>
                    <div class="fanoos-bottom"></div>
                    <div class="fanoos-droplet"></div>
                </div>
            </div>
            <div class="fanoos-container lamp-3">
                <div class="fanoos-chain" style="height:120px;"></div>
                <div class="fanoos">
                    <div class="fanoos-top"></div>
                    <div class="fanoos-body"></div>
                    <div class="fanoos-glow"></div>
                    <div class="fanoos-bottom"></div>
                    <div class="fanoos-droplet"></div>
                </div>
            </div>
            <div class="fanoos-container lamp-4">
                <div class="fanoos-chain" style="height:200px;"></div>
                <div class="fanoos">
                    <div class="fanoos-top"></div>
                    <div class="fanoos-body"></div>
                    <div class="fanoos-glow"></div>
                    <div class="fanoos-bottom"></div>
                    <div class="fanoos-droplet"></div>
                </div>
            </div>
            <div class="fanoos-container lamp-5">
                <div class="fanoos-chain" style="height:160px;"></div>
                <div class="fanoos">
                    <div class="fanoos-top"></div>
                    <div class="fanoos-body"></div>
                    <div class="fanoos-glow"></div>
                    <div class="fanoos-bottom"></div>
                    <div class="fanoos-droplet"></div>
                </div>
            </div>
            <div class="fanoos-container lamp-6">
                <div class="fanoos-chain" style="height:140px;"></div>
                <div class="fanoos">
                    <div class="fanoos-top"></div>
                    <div class="fanoos-body"></div>
                    <div class="fanoos-glow"></div>
                    <div class="fanoos-bottom"></div>
                    <div class="fanoos-droplet"></div>
                </div>
            </div>

            <!-- Audio Player -->
            <div class="music-player-panel" id="musicPlayerPanel">
                <div class="panel-toggle" id="panelToggle">
                    <i class="fa fa-chevron-left" id="toggleIcon" style="transition: transform 0.6s;"></i>
                </div>
                <div class="panel-content">
                    <h5 style="text-align:center; color:#d4af37; font-family:serif; margin-bottom:15px; letter-spacing: 1px;">🌙 RAMADAN KAREEM</h5>
                    <div style="display:flex; align-items:center; gap:15px;">
                        <button class="play-pause-btn" id="playPauseBtn">
                            <i class="fa fa-play"></i>
                        </button>
                        <input type="range" class="seek-slider" id="seekSlider" value="0" step="0.1" min="0"/>
                    </div>
                    <audio id="ramadanSong" loop="loop">
                        <source src="/ramadan_ux_design/static/description/song.mp3" type="audio/mpeg"/>
                    </audio>
                </div>
            </div>
        </xpath>

        <xpath expr="//body" position="after">
            <script type="text/javascript">
                <![CDATA[
                document.addEventListener('DOMContentLoaded', function() {
                    // === Generate Stars ===
                    const starfield = document.getElementById('starfield');
                    if (starfield) {
                        // Create 300 stars
                        for (let i = 0; i < 300; i++) {
                            const star = document.createElement('div');
                            star.className = 'star';
                            // Random size
                            const size = Math.random();
                            if (size < 0.6) star.classList.add('small');
                            else if (size < 0.9) star.classList.add('medium');
                            else star.classList.add('large');
                            
                            // Random position
                            star.style.left = Math.random() * 100 + '%';
                            star.style.top = Math.random() * 100 + '%';
                            
                            // Random twinkle duration (2-5s)
                            const duration = 2 + Math.random() * 3;
                            star.style.setProperty('--twinkle-duration', duration + 's');
                            
                            starfield.appendChild(star);
                        }
                        
                        // Create 5 shooting stars
                        for (let i = 0; i < 5; i++) {
                            const shooting = document.createElement('div');
                            shooting.className = 'shooting-star';
                            shooting.style.animationDelay = i * 7 + 's';
                            starfield.appendChild(shooting);
                        }
                    }

                    // === Music Player Logic ===
                    const panel = document.getElementById('musicPlayerPanel');
                    const toggle = document.getElementById('panelToggle');
                    const icon = document.getElementById('toggleIcon');
                    const audio = document.getElementById('ramadanSong');
                    const btn = document.getElementById('playPauseBtn');
                    const slider = document.getElementById('seekSlider');

                    toggle.addEventListener('click', () => {
                        panel.classList.toggle('open');
                        icon.style.transform = panel.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0deg)';
                    });

                    btn.addEventListener('click', () => {
                        if (audio.paused) {
                            audio.play().catch(e => console.log("Play blocked by browser, wait for user interaction."));
                            btn.innerHTML = '<i class="fa fa-pause"></i>';
                        } else {
                            audio.pause();
                            btn.innerHTML = '<i class="fa fa-play"></i>';
                        }
                    });

                    audio.addEventListener('timeupdate', () => {
                        if (!isNaN(audio.duration)) {
                            slider.max = audio.duration;
                            slider.value = audio.currentTime;
                        }
                    });

                    slider.addEventListener('input', () => {
                        audio.currentTime = slider.value;
                    });
                });
                ]]>
            </script>
        </xpath>
    </template>
</odoo>
