<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ramadan_theme_layout" name="Ramadan Theme Elements" inherit_id="website.layout" priority="50">
        <xpath expr="//body" position="inside">
            <!-- Ramadan decorations container -->
            <div class="ramadan-decorations" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5;">
                <div class="starfield"></div>
                <div class="crescent-moon"></div>
                <div class="lantern left-lantern"></div>
                <div class="lantern right-lantern"></div>
            </div>
            <div class="ramadan-audio" style="display: none;">
                <audio id="ramadanSong" preload="metadata" loop>
                    <source src="/ramadan_ux_design/static/description/song.mp3" type="audio/mpeg"/>
                </audio>
            </div>
            <div class="music-player-panel" id="musicPlayerPanel">
                <div class="panel-content">
                    <h4 class="song-title">Ramadan Soul</h4>
                    <div class="player-controls">
                        <button class="play-pause-btn" id="playPauseBtn">
                            <i class="fa fa-play"></i>
                        </button>
                        <input type="range" class="seek-slider" id="seekSlider" value="0" step="0.1" min="0"/>
                    </div>
                </div>
                <div class="panel-toggle" id="panelToggle">
                    <i class="fa fa-music"></i>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
