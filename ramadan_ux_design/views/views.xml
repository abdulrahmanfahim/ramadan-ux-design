<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ramadan_theme_layout" name="Ramadan Theme Elements" inherit_id="website.layout" priority="50">
        <xpath expr="//head" position="inside">
            <style type="text/css">
                <![CDATA[
                /* ===== GOLDEN STARRY SKY ===== */
                .starfield {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    pointer-events: none;
                    z-index: -1;
                    background: radial-gradient(ellipse at 30% 40%, #0a2e28 0%, #020d0b 100%);
                    overflow: hidden;
                }

                .star {
                    position: absolute;
                    background-color: #ffd700;
                    border-radius: 50%;
                    box-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
                    animation: twinkle 4s infinite ease-in-out;
                }

                .star.small { width: 1px; height: 1px; }
                .star.medium { width: 2px; height: 2px; box-shadow: 0 0 10px #ffaa00; }
                .star.large { width: 3px; height: 3px; box-shadow: 0 0 12px #ffaa33; }

                @keyframes twinkle {
                    0%, 100% { opacity: 0.8; }
                    50% { opacity: 0.2; }
                }

                /* ===== SINGLE CRESCENT MOON ===== */
                .crescent-moon {
                    position: absolute;
                    top: 60px;
                    left: 10%;
                    width: 140px;
                    height: 140px;
                    border-radius: 50%;
                    box-shadow: -25px 15px 0 0 #fff9e6;
                    transform: rotate(-10deg);
                    filter: drop-shadow(0 0 15px #ffd700);
                    z-index: 5;
                    opacity: 0.9;
                }

                /* ===== ORNATE ARABIC LANTERNS (FANOUS) ===== */
                .fanous-container {
                    position: absolute;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    transform-origin: top center;
                    z-index: 10;
                    filter: drop-shadow(0 10px 8px rgba(0,0,0,0.6));
                    animation: gentleSwing 5s infinite ease-in-out;
                }

                /* Chain - thin bronze links */
                .fanous-chain {
                    width: 4px;
                    height: 120px;
                    background: repeating-linear-gradient(45deg, #b8860b 0px 4px, #8b6913 4px 8px);
                    box-shadow: 0 0 8px #b8860b;
                }

                /* Lantern body wrapper */
                .fanous {
                    position: relative;
                    width: 80px;
                    height: 130px;
                }

                /* Onion-shaped dome */
                .fanous-dome {
                    position: absolute;
                    top: -20px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 50px;
                    height: 30px;
                    background: radial-gradient(circle at 30% 30%, #c9a44b, #7d5d1a);
                    border-radius: 50% 50% 40% 40%;
                    border-bottom: 3px solid #d4af37;
                    box-shadow: inset -2px -2px 5px #3a2e0b, inset 2px 2px 5px #ffeb99;
                }

                /* Hexagonal body */
                .fanous-body {
                    position: relative;
                    width: 100%;
                    height: 100%;
                    background: #1e1e1e; /* dark metal */
                    clip-path: polygon(25% 0%, 75% 0%, 100% 15%, 100% 85%, 75% 100%, 25% 100%, 0% 85%, 0% 15%);
                    border: 2px solid #b8860b;
                    box-shadow: inset 0 0 20px #2a1f05, 0 5px 15px rgba(0,0,0,0.7);
                    overflow: hidden;
                }

                /* Intricate ironwork (filigree) */
                .fanous-filigree {
                    position: absolute;
                    top: 5%;
                    left: 5%;
                    width: 90%;
                    height: 90%;
                    background-image: 
                        repeating-linear-gradient(45deg, transparent, transparent 8px, #b8860b 8px, #b8860b 10px),
                        repeating-linear-gradient(-45deg, transparent, transparent 8px, #b8860b 8px, #b8860b 10px);
                    opacity: 0.3;
                    pointer-events: none;
                }

                /* Pointed arch windows */
                .fanous-window {
                    position: absolute;
                    background: rgba(255, 200, 100, 0.2);
                    border: 1px solid #b8860b;
                    clip-path: polygon(20% 0%, 80% 0%, 100% 100%, 0% 100%);
                }

                .window-1 { top: 15%; left: 15%; width: 20%; height: 30%; }
                .window-2 { top: 15%; right: 15%; width: 20%; height: 30%; }
                .window-3 { bottom: 25%; left: 10%; width: 20%; height: 30%; }
                .window-4 { bottom: 25%; right: 10%; width: 20%; height: 30%; }
                .window-5 { top: 40%; left: 25%; width: 20%; height: 25%; }
                .window-6 { top: 40%; right: 25%; width: 20%; height: 25%; }

                /* Glow from within */
                .fanous-glow {
                    position: absolute;
                    top: 15%;
                    left: 15%;
                    width: 70%;
                    height: 70%;
                    background: radial-gradient(circle, #ffaa33 0%, #cc7700 80%);
                    border-radius: 50%;
                    filter: blur(15px);
                    opacity: 0.7;
                    animation: glowPulse 3s infinite alternate;
                }

                @keyframes glowPulse {
                    0% { opacity: 0.5; filter: blur(12px); }
                    100% { opacity: 0.8; filter: blur(18px); }
                }

                /* Bottom finial */
                .fanous-finial {
                    position: absolute;
                    bottom: -12px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 16px;
                    height: 16px;
                    background: linear-gradient(145deg, #c9a44b, #7d5d1a);
                    border-radius: 50% 50% 40% 40%;
                    box-shadow: 0 5px 8px #00000066;
                }

                /* Tiny golden droplets */
                .fanous-droplet {
                    position: absolute;
                    bottom: -20px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 4px;
                    height: 8px;
                    background: #ffaa33;
                    border-radius: 50%;
                    box-shadow: 0 0 8px #ffaa00;
                    animation: dropletDangle 2s infinite alternate;
                }

                .fanous-droplet::before,
                .fanous-droplet::after {
                    content: '';
                    position: absolute;
                    width: 3px;
                    height: 6px;
                    background: #ffaa33;
                    border-radius: 50%;
                    top: 5px;
                }
                .fanous-droplet::before { left: -6px; }
                .fanous-droplet::after { right: -6px; }

                @keyframes dropletDangle {
                    0% { transform: translateX(-50%) rotate(-2deg); }
                    100% { transform: translateX(-50%) rotate(2deg); }
                }

                /* Gentle swinging for lanterns (different speeds) */
                .lamp-1 { left: 5%; top: 15%; animation: gentleSwing 6s infinite ease-in-out; }
                .lamp-2 { left: 18%; top: 30%; animation: gentleSwing 7s infinite ease-in-out; }
                .lamp-3 { right: 10%; top: 20%; animation: gentleSwing 5.5s infinite ease-in-out; }
                .lamp-4 { right: 22%; top: 35%; animation: gentleSwing 8s infinite ease-in-out; }

                @keyframes gentleSwing {
                    0%, 100% { transform: rotate(-1.5deg); }
                    50% { transform: rotate(1.5deg); }
                }

                /* ===== MUSIC PLAYER PANEL ===== */
                .music-player-panel {
                    position: fixed;
                    top: 50%;
                    right: -310px;
                    transform: translateY(-50%);
                    display: flex;
                    align-items: center;
                    z-index: 2000;
                    transition: right 0.6s ease;
                }
                .music-player-panel.open { right: 0; }

                .panel-toggle {
                    width: 45px;
                    height: 140px;
                    background: linear-gradient(135deg, #d4af37, #b8860b);
                    color: #020d0b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    cursor: pointer;
                    border-radius: 20px 0 0 20px;
                    box-shadow: -5px 0 15px rgba(0,0,0,0.5);
                    border: 1px solid #ffcc33;
                    border-right: none;
                    font-size: 24px; /* for music note */
                }
                .panel-toggle:hover {
                    background: #ffcc33;
                }

                .panel-content {
                    width: 310px;
                    background: rgba(8, 20, 15, 0.95);
                    backdrop-filter: blur(20px);
                    padding: 25px;
                    border-left: 3px solid #d4af37;
                    box-shadow: -10px 0 30px rgba(0,0,0,0.6);
                }

                .play-pause-btn {
                    background: #d4af37;
                    border: none;
                    border-radius: 50%;
                    width: 50px;
                    height: 50px;
                    cursor: pointer;
                    color: #020d0b;
                    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
                    transition: transform 0.2s ease;
                }
                .play-pause-btn:hover { transform: scale(1.1); background: #ffcc33; }

                .seek-slider { flex: 1; accent-color: #d4af37; cursor: pointer; }

                /* Transparent content area */
                #wrap {
                    position: relative;
                    z-index: 15;
                    background: transparent !important;
                    border-radius: 20px;
                    margin: 20px;
                    padding: 20px;
                }
                ]]>
            </style>
        </xpath>

        <xpath expr="//body" position="inside">
            <!-- Starry Sky -->
            <div class="starfield" id="starfield"></div>

            <!-- Single Crescent -->
            <div class="crescent-moon"></div>

            <!-- Four Ornate Lanterns -->
            <div class="fanous-container lamp-1">
                <div class="fanous-chain" style="height:140px;"></div>
                <div class="fanous">
                    <div class="fanous-dome"></div>
                    <div class="fanous-body">
                        <div class="fanous-filigree"></div>
                        <div class="fanous-window window-1"></div>
                        <div class="fanous-window window-2"></div>
                        <div class="fanous-window window-3"></div>
                        <div class="fanous-window window-4"></div>
                        <div class="fanous-window window-5"></div>
                        <div class="fanous-window window-6"></div>
                        <div class="fanous-glow"></div>
                    </div>
                    <div class="fanous-finial"></div>
                    <div class="fanous-droplet"></div>
                </div>
            </div>

            <div class="fanous-container lamp-2">
                <div class="fanous-chain" style="height:180px;"></div>
                <div class="fanous">
                    <div class="fanous-dome"></div>
                    <div class="fanous-body">
                        <div class="fanous-filigree"></div>
                        <div class="fanous-window window-1"></div>
                        <div class="fanous-window window-2"></div>
                        <div class="fanous-window window-3"></div>
                        <div class="fanous-window window-4"></div>
                        <div class="fanous-window window-5"></div>
                        <div class="fanous-window window-6"></div>
                        <div class="fanous-glow"></div>
                    </div>
                    <div class="fanous-finial"></div>
                    <div class="fanous-droplet"></div>
                </div>
            </div>

            <div class="fanous-container lamp-3">
                <div class="fanous-chain" style="height:110px;"></div>
                <div class="fanous">
                    <div class="fanous-dome"></div>
                    <div class="fanous-body">
                        <div class="fanous-filigree"></div>
                        <div class="fanous-window window-1"></div>
                        <div class="fanous-window window-2"></div>
                        <div class="fanous-window window-3"></div>
                        <div class="fanous-window window-4"></div>
                        <div class="fanous-window window-5"></div>
                        <div class="fanous-window window-6"></div>
                        <div class="fanous-glow"></div>
                    </div>
                    <div class="fanous-finial"></div>
                    <div class="fanous-droplet"></div>
                </div>
            </div>

            <div class="fanous-container lamp-4">
                <div class="fanous-chain" style="height:160px;"></div>
                <div class="fanous">
                    <div class="fanous-dome"></div>
                    <div class="fanous-body">
                        <div class="fanous-filigree"></div>
                        <div class="fanous-window window-1"></div>
                        <div class="fanous-window window-2"></div>
                        <div class="fanous-window window-3"></div>
                        <div class="fanous-window window-4"></div>
                        <div class="fanous-window window-5"></div>
                        <div class="fanous-window window-6"></div>
                        <div class="fanous-glow"></div>
                    </div>
                    <div class="fanous-finial"></div>
                    <div class="fanous-droplet"></div>
                </div>
            </div>

            <!-- Music Panel -->
            <div class="music-player-panel" id="musicPlayerPanel">
                <div class="panel-toggle" id="panelToggle">
                    <span id="toggleIcon">♬</span> <!-- Music note icon -->
                </div>
                <div class="panel-content">
                    <h5 style="text-align:center; color:#d4af37; margin-bottom:15px;">🌙 RAMADAN KAREEM</h5>
                    <div style="display:flex; align-items:center; gap:15px;">
                        <button class="play-pause-btn" id="playPauseBtn">
                            <i class="fa fa-play"></i>
                        </button>
                        <input type="range" class="seek-slider" id="seekSlider" value="0" step="0.1" min="0"/>
                    </div>
                    <audio id="ramadanSong" loop="loop">
                        <source src="/ramadan_ux_design/static/description/song.mp3" type="audio/mpeg"/>
                    </audio>
                </div>
            </div>
        </xpath>

        <xpath expr="//body" position="after">
            <script type="text/javascript">
                <![CDATA[
                document.addEventListener('DOMContentLoaded', function() {
                    // Stars generation (300 stars)
                    const starfield = document.getElementById('starfield');
                    if (starfield) {
                        for (let i = 0; i < 300; i++) {
                            const star = document.createElement('div');
                            star.className = 'star';
                            const r = Math.random();
                            if (r < 0.6) star.classList.add('small');
                            else if (r < 0.9) star.classList.add('medium');
                            else star.classList.add('large');
                            star.style.left = Math.random() * 100 + '%';
                            star.style.top = Math.random() * 100 + '%';
                            star.style.animationDelay = (Math.random() * 5) + 's';
                            starfield.appendChild(star);
                        }
                    }

                    // Music player
                    const panel = document.getElementById('musicPlayerPanel');
                    const toggle = document.getElementById('panelToggle');
                    const icon = document.getElementById('toggleIcon');
                    const audio = document.getElementById('ramadanSong');
                    const btn = document.getElementById('playPauseBtn');
                    const slider = document.getElementById('seekSlider');

                    toggle.addEventListener('click', () => {
                        panel.classList.toggle('open');
                        // No rotation needed for music note, but we could change symbol if desired
                    });

                    btn.addEventListener('click', () => {
                        if (audio.paused) {
                            audio.play().catch(e => console.log("Play blocked"));
                            btn.innerHTML = '<i class="fa fa-pause"></i>';
                        } else {
                            audio.pause();
                            btn.innerHTML = '<i class="fa fa-play"></i>';
                        }
                    });

                    audio.addEventListener('timeupdate', () => {
                        if (!isNaN(audio.duration)) {
                            slider.max = audio.duration;
                            slider.value = audio.currentTime;
                        }
                    });

                    slider.addEventListener('input', () => {
                        audio.currentTime = slider.value;
                    });
                });
                ]]>
            </script>
        </xpath>
    </template>
</odoo>
