<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ramadan_theme_layout" name="Ramadan Theme Elements" inherit_id="website.layout" priority="50">
        <xpath expr="//head" position="inside">
            <style type="text/css">
                <![CDATA[
                body {
                    background: radial-gradient(circle at center, #0a2e28 0%, #020d0b 100%) !important;
                    position: relative;
                    min-height: 100vh;
                    color: #f5e6d3;
                    overflow-x: hidden;
                }

                .fanoos-container {
                    position: absolute;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    animation: lampSwing 5s infinite ease-in-out;
                    transform-origin: top center;
                    z-index: 10;
                    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                }

                .fanoos-container:hover {
                    filter: drop-shadow(0 0 20px #ffaa00);
                    transform: scale(1.1) rotate(0deg) !important;
                }

                @keyframes lampSwing {
                    0%, 100% { transform: rotate(-3deg); }
                    50% { transform: rotate(3deg); }
                }

                .fanoos-body::before {
                    content: '';
                    position: absolute;
                    top: 10%; left: 10%; width: 80%; height: 80%;
                    background: radial-gradient(circle, #fff3b0 0%, #ffaa00 60%, #805500 100%);
                    clip-path: polygon(20% 0%, 80% 0%, 100% 50%, 80% 100%, 20% 100%, 0% 50%);
                    animation: lanternPulse 3s infinite ease-in-out;
                }

                @keyframes lanternPulse {
                    0%, 100% { opacity: 0.6; filter: brightness(0.8); }
                    50% { opacity: 1; filter: brightness(1.4); }
                }

                .music-player-panel {
                    position: fixed;
                    top: 50%;
                    right: -310px; /* Fully hide content (310px width) */
                    transform: translateY(-50%);
                    display: flex;
                    align-items: center;
                    z-index: 2000;
                    transition: right 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
                }

                .music-player-panel.open {
                    right: 0;
                }

                .panel-toggle {
                    width: 45px;
                    height: 140px;
                    background: linear-gradient(135deg, #d4af37, #b8860b);
                    color: #020d0b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    cursor: pointer;
                    border-radius: 20px 0 0 20px;
                    box-shadow: -5px 0 15px rgba(0,0,0,0.5);
                    border: 1px solid #ffcc33;
                    border-right: none;
                }

                .panel-content {
                    width: 310px;
                    background: rgba(8, 20, 15, 0.95);
                    backdrop-filter: blur(15px);
                    padding: 25px;
                    border-left: 3px solid #d4af37;
                    box-shadow: -10px 0 30px rgba(0,0,0,0.6);
                }

                .play-pause-btn {
                    background: #d4af37;
                    border: none;
                    border-radius: 50%;
                    width: 50px;
                    height: 50px;
                    cursor: pointer;
                    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                }

                .play-pause-btn:hover { transform: scale(1.1); background: #ffcc33; }
                .seek-slider { flex: 1; accent-color: #d4af37; cursor: pointer; }

                /* Static Decorations */
                .fanoos-chain { width: 2px; height: 150px; background: linear-gradient(to bottom, #4a3b1a, #b8860b); }
                .fanoos { position: relative; width: 60px; height: 100px; }
                .fanoos-top { position: absolute; top: -25px; left: 50%; transform: translateX(-50%); width: 40px; height: 30px; background: #1a1a1a; clip-path: polygon(20% 100%, 80% 100%, 100% 50%, 50% 0%, 0% 50%); border-bottom: 2px solid #d4af37; }
                .fanoos-body { width: 100%; height: 100%; background: #1a1a1a; clip-path: polygon(15% 0%, 85% 0%, 100% 25%, 100% 75%, 85% 100%, 15% 100%, 0% 75%, 0% 25%); border: 1px solid #d4af37; position: relative; }
                .fanoos-droplet { position: absolute; bottom: -25px; left: 50%; transform: translateX(-50%); width: 8px; height: 12px; background: #ffcc33; border-radius: 50%; box-shadow: 0 0 10px #ffaa00; }
                .lamp-1 { left: 10%; }
                .lamp-2 { left: 50%; }
                .lamp-3 { left: 90%; }
                .crescent-moon { position: absolute; top: 100px; left: 20%; width: 120px; height: 120px; border-radius: 50%; box-shadow: -20px 15px 0 0 #fff9e6; transform: rotate(-15deg); filter: blur(1px); }
                ]]>
            </style>
        </xpath>

        <xpath expr="//body" position="inside">
            <div class="ramadan-decorations">
                <div class="crescent-moon"></div>
                <t t-foreach="[1, 2, 3]" t-as="i">
                    <div t-attf-class="fanoos-container lamp-{{i}}">
                        <div class="fanoos-chain"></div>
                        <div class="fanoos">
                            <div class="fanoos-top"></div>
                            <div class="fanoos-body"></div>
                            <div class="fanoos-droplet"></div>
                        </div>
                    </div>
                </t>
            </div>

            <div class="music-player-panel" id="musicPlayerPanel">
                <div class="panel-toggle" id="panelToggle">
                    <i class="fa fa-chevron-left" id="toggleIcon" style="transition: transform 0.4s;"></i>
                </div>
                <div class="panel-content">
                    <h5 style="text-align:center; color:#d4af37; margin-bottom:15px;">RAMADAN KAREEM</h5>
                    <div style="display:flex; align-items:center; gap:15px;">
                        <button class="play-pause-btn" id="playPauseBtn">
                            <i class="fa fa-play"></i>
                        </button>
                        <input type="range" class="seek-slider" id="seekSlider" value="0" step="0.1" min="0"/>
                    </div>
                    <audio id="ramadanSong" loop="loop">
                        <source src="/ramadan_ux_design/static/description/song.mp3" type="audio/mpeg"/>
                    </audio>
                </div>
            </div>
        </xpath>

        <xpath expr="//body" position="after">
            <script type="text/javascript">
                <![CDATA[
                document.addEventListener('DOMContentLoaded', function() {
                    const panel = document.getElementById('musicPlayerPanel');
                    const toggle = document.getElementById('panelToggle');
                    const icon = document.getElementById('toggleIcon');
                    const audio = document.getElementById('ramadanSong');
                    const btn = document.getElementById('playPauseBtn');
                    const slider = document.getElementById('seekSlider');

                    toggle.addEventListener('click', () => {
                        panel.classList.toggle('open');
                        icon.style.transform = panel.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0deg)';
                    });

                    btn.addEventListener('click', () => {
                        if (audio.paused) {
                            audio.play();
                            btn.innerHTML = '<i class="fa fa-pause"></i>';
                        } else {
                            audio.pause();
                            btn.innerHTML = '<i class="fa fa-play"></i>';
                        }
                    });

                    audio.addEventListener('timeupdate', () => {
                        if (!isNaN(audio.duration)) {
                            slider.max = audio.duration;
                            slider.value = audio.currentTime;
                        }
                    });

                    slider.addEventListener('input', () => {
                        audio.currentTime = slider.value;
                    });
                });
                ]]>
            </script>
        </xpath>
    </template>
</odoo>
