<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ramadan_theme_layout" name="Ramadan Theme Elements" inherit_id="website.layout" priority="50">
        <xpath expr="//head" position="inside">
            <style type="text/css">
                <![CDATA[
                /* ===== GOLDEN STARRY SKY WITH GLOW ===== */
                .starfield {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    pointer-events: none;
                    z-index: -1;
                    background: radial-gradient(ellipse at 30% 40%, #0a2e28 0%, #020d0b 100%);
                    overflow: hidden;
                }

                .star {
                    position: absolute;
                    background-color: #ffd700;
                    border-radius: 50%;
                    opacity: 0;
                    animation: fallDown linear infinite;
                }

                .star.small { 
                    width: 2px; 
                    height: 2px; 
                    box-shadow: 0 0 12px 2px #ffd700, 0 0 20px 4px #ffaa33;
                }
                .star.medium { 
                    width: 3px; 
                    height: 3px; 
                    box-shadow: 0 0 15px 3px #ffd700, 0 0 30px 6px #ffaa33;
                }
                .star.large { 
                    width: 4px; 
                    height: 4px; 
                    box-shadow: 0 0 20px 4px #ffd700, 0 0 40px 8px #ffaa33;
                }

                @keyframes fallDown {
                    0% {
                        opacity: 0;
                        transform: translateY(-10vh) scale(0.5);
                    }
                    10% {
                        opacity: 1;
                        transform: translateY(0) scale(1);
                    }
                    90% {
                        opacity: 1;
                        transform: translateY(90vh) scale(1);
                    }
                    100% {
                        opacity: 0;
                        transform: translateY(110vh) scale(0.5);
                    }
                }

                /* ===== ENHANCED CRESCENT MOON ===== */
                .crescent-moon {
                    position: absolute;
                    top: 60px;
                    left: 5%;
                    width: 140px;
                    height: 140px;
                    border-radius: 50%;
                    box-shadow: -25px 15px 0 0 #fff9e6, 0 0 30px 10px rgba(255, 215, 0, 0.6);
                    transform: rotate(-10deg);
                    filter: drop-shadow(0 0 30px #ffaa00) drop-shadow(0 0 60px #ff7700);
                    z-index: 0;
                    opacity: 0.9;
                    pointer-events: none;
                    animation: moonGlow 4s infinite alternate;
                }

                .crescent-moon::after {
                    content: '';
                    position: absolute;
                    top: -10px;
                    left: -10px;
                    width: 160px;
                    height: 160px;
                    border-radius: 50%;
                    background: radial-gradient(circle at 30% 30%, rgba(255,215,0,0.3), transparent 70%);
                    filter: blur(15px);
                }

                @keyframes moonGlow {
                    0% { filter: drop-shadow(0 0 20px #ffaa00) drop-shadow(0 0 40px #ff7700); }
                    100% { filter: drop-shadow(0 0 40px #ffdd55) drop-shadow(0 0 80px #ffaa00); }
                }

                /* Mobile adjustments for crescent */
                @media (max-width: 768px) {
                    .crescent-moon {
                        top: 80px;
                        left: 3%;
                        width: 90px;
                        height: 90px;
                        box-shadow: -15px 9px 0 0 #fff9e6;
                    }
                }

                /* ===== FANOUS CONTAINER - LEFT LAMP CONNECTED TO MOON ===== */
                .fanous-container {
                    position: absolute;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    transform-origin: top center;
                    z-index: 1;
                    filter: drop-shadow(0 10px 8px rgba(0,0,0,0.6));
                    pointer-events: none;
                }

                /* Chain - more realistic with glow */
                .fanous-chain {
                    width: 3px;
                    background: repeating-linear-gradient(45deg, #ffd700 0px 4px, #b8860b 4px 8px);
                    box-shadow: 0 0 15px #ffaa00, 0 0 30px #ff7700;
                    border-radius: 2px;
                }

                /* The lantern image - enhanced glow */
                .fanous-image {
                    display: block;
                    max-width: 120px;
                    height: auto;
                    margin-top: 0px;
                    filter: drop-shadow(0 0 15px #ffaa00) drop-shadow(0 0 30px #ff7700);
                    transition: filter 0.3s ease;
                    pointer-events: none;
                }

                .fanous-image:hover {
                    filter: drop-shadow(0 0 30px #ffdd55) drop-shadow(0 0 60px #ffaa00);
                }

                /* Desktop lamp positions */
                .lamp-1 { 
                    left: 2%; 
                    top: 150px;  /* Aligned with moon's tip */
                }
                .lamp-1 .fanous-chain {
                    height: 100px;  /* Chain connects to moon tip */
                }
                
                .lamp-2 { 
                    left: 18%; 
                    top: 28%; 
                    animation: gentleSwing 4s infinite ease-in-out; 
                }
                .lamp-2 .fanous-chain { height: 150px; }
                
                .lamp-3 { 
                    right: 5%; 
                    top: 18%; 
                    animation: gentleSwing 3.8s infinite ease-in-out; 
                }
                .lamp-3 .fanous-chain { height: 100px; }
                
                .lamp-4 { 
                    right: 18%; 
                    top: 32%; 
                    animation: gentleSwing 4.2s infinite ease-in-out; 
                }
                .lamp-4 .fanous-chain { height: 140px; }

                /* Mobile: only 2 lanterns, smaller, repositioned */
                @media (max-width: 768px) {
                    .lamp-1, .lamp-4 { display: flex; }
                    .lamp-2, .lamp-3 { display: none; }
                    
                    .lamp-1 { 
                        left: 3%; 
                        top: 150px;
                    }
                    .lamp-1 .fanous-chain { 
                        height: 70px; 
                    }
                    
                    .lamp-4 { 
                        right: 3%; 
                        top: 250px;
                    }
                    .lamp-4 .fanous-chain { 
                        height: 60px; 
                    }
                    
                    .fanous-image {
                        max-width: 70px;
                    }
                }

                /* Small phones */
                @media (max-width: 480px) {
                    .lamp-1 { top: 130px; }
                    .lamp-1 .fanous-chain { height: 60px; }
                    
                    .lamp-4 { top: 220px; }
                    .lamp-4 .fanous-chain { height: 50px; }
                    
                    .fanous-image {
                        max-width: 55px;
                    }
                }

                @keyframes gentleSwing {
                    0%, 100% { transform: rotate(-1.5deg); }
                    50% { transform: rotate(1.5deg); }
                }

                /* ===== MUSIC TOGGLE BUTTON - DIRECT MUSIC CONTROL ===== */
                .music-toggle {
                    position: fixed;
                    top: 50%;
                    right: 20px;
                    transform: translateY(-50%);
                    width: 60px;
                    height: 60px;
                    background: linear-gradient(135deg, #ffd700, #b8860b);
                    color: #020d0b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    cursor: pointer;
                    border-radius: 50%;
                    box-shadow: 0 0 20px #ffaa00, 0 0 40px #ff7700, 0 4px 15px rgba(0,0,0,0.5);
                    border: 2px solid #ffcc33;
                    font-size: 28px;
                    z-index: 1000;
                    pointer-events: auto;
                    transition: all 0.3s ease;
                    animation: buttonPulse 2s infinite alternate;
                }

                .music-toggle:hover {
                    transform: translateY(-50%) scale(1.15);
                    background: linear-gradient(135deg, #ffdd55, #d4af37);
                    box-shadow: 0 0 30px #ffdd55, 0 0 60px #ffaa00;
                }

                .music-toggle.playing {
                    background: linear-gradient(135deg, #ffaa33, #cc7700);
                    box-shadow: 0 0 30px #ff5500, 0 0 60px #ff3300;
                }

                @keyframes buttonPulse {
                    0% { box-shadow: 0 0 20px #ffaa00, 0 0 40px #ff7700; }
                    100% { box-shadow: 0 0 30px #ffdd55, 0 0 60px #ffaa00; }
                }

                /* Mobile music toggle adjustment */
                @media (max-width: 768px) {
                    .music-toggle {
                        width: 50px;
                        height: 50px;
                        right: 15px;
                        font-size: 24px;
                    }
                }

                /* Small phones */
                @media (max-width: 480px) {
                    .music-toggle {
                        width: 45px;
                        height: 45px;
                        right: 10px;
                        font-size: 22px;
                    }
                }

                /* Transparent content area */
                #wrap {
                    position: relative;
                    z-index: 10;
                    background: transparent !important;
                    border-radius: 20px;
                    margin: 15px;
                    padding: 15px;
                }

                /* Ensure navbar and hamburger menu stay on top */
                .navbar, header, .o_main_navbar, .o_menu_sections, .o_menu_toggle {
                    position: relative;
                    z-index: 100 !important;
                }

                /* Ensure form fields and interactive elements are above decorations */
                input, textarea, select, .btn, a, .o_dropdown, .modal, .dropdown-menu {
                    position: relative;
                    z-index: 50;
                }

                /* Make sure modals and popups are above everything */
                .modal, .modal-content, .popover, .tooltip {
                    z-index: 2000 !important;
                }

                /* Mobile navbar fixes */
                @media (max-width: 768px) {
                    .navbar-brand, .o_menu_toggle {
                        z-index: 101 !important;
                    }
                    
                    .o_menu_sections {
                        z-index: 102 !important;
                    }
                }

                .dropdown-menu, .o_dropdown_menu {
                    pointer-events: auto !important;
                    z-index: 1000 !important;
                }
                ]]>
            </style>
        </xpath>

        <xpath expr="//body" position="inside">
            <!-- Starry Sky with Glow -->
            <div class="starfield" id="starfield"></div>

            <!-- Enhanced Crescent Moon -->
            <div class="crescent-moon"></div>

            <!-- Lanterns with Glow -->
            <div class="fanous-container lamp-1">
                <div class="fanous-chain"></div>
                <img class="fanous-image" src="/ramadan_ux_design/static/description/fanoos.png" alt="Ramadan Lantern"/>
            </div>

            <div class="fanous-container lamp-2">
                <div class="fanous-chain"></div>
                <img class="fanous-image" src="/ramadan_ux_design/static/description/fanoos.png" alt="Ramadan Lantern"/>
            </div>

            <div class="fanous-container lamp-3">
                <div class="fanous-chain"></div>
                <img class="fanous-image" src="/ramadan_ux_design/static/description/fanoos.png" alt="Ramadan Lantern"/>
            </div>

            <div class="fanous-container lamp-4">
                <div class="fanous-chain"></div>
                <img class="fanous-image" src="/ramadan_ux_design/static/description/fanoos.png" alt="Ramadan Lantern"/>
            </div>

            <!-- Music Toggle Button (direct control) -->
            <div class="music-toggle" id="musicToggle">
                <span id="toggleIcon">♬</span>
            </div>

            <!-- Hidden Audio Element -->
            <audio id="ramadanSong" loop="loop" preload="auto">
                <source src="/ramadan_ux_design/static/description/song.mp3" type="audio/mpeg"/>
            </audio>
        </xpath>

        <xpath expr="//body" position="after">
            <script type="text/javascript">
                <![CDATA[
                document.addEventListener('DOMContentLoaded', function() {
                    // Stars generation with enhanced glow
                    const starfield = document.getElementById('starfield');
                    const isMobile = window.innerWidth <= 768;
                    
                    if (starfield) {
                        starfield.innerHTML = '';
                        const starCount = isMobile ? 150 : 300;
                        
                        for (let i = 0; i < starCount; i++) {
                            const star = document.createElement('div');
                            star.className = 'star';
                            
                            const r = Math.random();
                            if (r < 0.6) star.classList.add('small');
                            else if (r < 0.9) star.classList.add('medium');
                            else star.classList.add('large');
                            
                            star.style.left = Math.random() * 100 + '%';
                            star.style.top = (Math.random() * 20 - 10) + '%';
                            
                            const duration = isMobile ? 3 + Math.random() * 3 : 4 + Math.random() * 4;
                            star.style.animation = `fallDown ${duration}s linear infinite`;
                            star.style.animationDelay = (Math.random() * 5) + 's';
                            
                            starfield.appendChild(star);
                        }
                    }

                    // Direct music control (no container)
                    const toggle = document.getElementById('musicToggle');
                    const audio = document.getElementById('ramadanSong');
                    const icon = document.getElementById('toggleIcon');
                    
                    let userInteracted = false;
                    
                    // Function to enable audio context after user interaction
                    function enableAutoplay() {
                        if (!userInteracted) {
                            userInteracted = true;
                            document.removeEventListener('click', enableAutoplay);
                            document.removeEventListener('touchstart', enableAutoplay);
                            document.removeEventListener('scroll', enableAutoplay);
                        }
                    }
                    
                    document.addEventListener('click', enableAutoplay, { once: true });
                    document.addEventListener('touchstart', enableAutoplay, { once: true });
                    document.addEventListener('scroll', enableAutoplay, { once: true });

                    // Toggle play/pause on button click
                    toggle.addEventListener('click', (e) => {
                        e.stopPropagation();
                        
                        if (audio.paused) {
                            // Only play if user has interacted
                            if (userInteracted) {
                                audio.play().catch(e => console.log("Play failed:", e));
                                toggle.classList.add('playing');
                                icon.innerHTML = '♩';
                            } else {
                                console.log("Waiting for user interaction first");
                                // Play anyway - browsers will block but we try
                                audio.play().catch(e => {
                                    console.log("Autoplay blocked - user must interact first");
                                    // Still show as playing attempt
                                    toggle.classList.add('playing');
                                    icon.innerHTML = '♩';
                                });
                            }
                        } else {
                            audio.pause();
                            toggle.classList.remove('playing');
                            icon.innerHTML = '♬';
                        }
                    });

                    // Update icon when audio ends
                    audio.addEventListener('ended', () => {
                        toggle.classList.remove('playing');
                        icon.innerHTML = '♬';
                    });
                    
                    // Remember play state across pages
                    window.addEventListener('beforeunload', function() {
                        sessionStorage.setItem('ramadanMusicPlaying', audio.paused ? 'false' : 'true');
                    });
                    
                    // Check if music was playing before navigation
                    if (sessionStorage.getItem('ramadanMusicPlaying') === 'true') {
                        // Mark as playing but don't autoplay - wait for interaction
                        toggle.classList.add('playing');
                        icon.innerHTML = '♩';
                    }
                });
                ]]>
            </script>
        </xpath>
    </template>
</odoo>
