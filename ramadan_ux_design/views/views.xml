<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="ramadan_theme_layout" name="Ramadan Theme Elements" inherit_id="website.layout" priority="50">
        <xpath expr="//head" position="inside">
            <style type="text/css">
                <![CDATA[
                /* ===== GOLDEN STARRY SKY - ABSOLUTELY LOWEST ===== */
                .starfield {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    pointer-events: none;
                    z-index: -1;  /* Behind everything */
                    background: radial-gradient(ellipse at 30% 40%, #0a2e28 0%, #020d0b 100%);
                    overflow: hidden;
                }

                .star {
                    position: absolute;
                    background-color: #ffd700;
                    border-radius: 50%;
                    box-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
                    opacity: 0;
                    animation: fallDown linear infinite;
                }

                .star.small { width: 1px; height: 1px; }
                .star.medium { width: 2px; height: 2px; box-shadow: 0 0 10px #ffaa00; }
                .star.large { width: 3px; height: 3px; box-shadow: 0 0 12px #ffaa33; }

                @keyframes fallDown {
                    0% {
                        opacity: 0;
                        transform: translateY(-10vh) scale(0.5);
                    }
                    5% {
                        opacity: 1;
                        transform: translateY(0) scale(1);
                    }
                    95% {
                        opacity: 1;
                        transform: translateY(90vh) scale(1);
                    }
                    100% {
                        opacity: 0;
                        transform: translateY(110vh) scale(0.5);
                    }
                }

                /* ===== SINGLE CRESCENT MOON - BACKGROUND DECORATION ===== */
                .crescent-moon {
                    position: absolute;
                    top: 60px;
                    left: 5%;
                    width: 120px;
                    height: 120px;
                    border-radius: 50%;
                    box-shadow: -20px 12px 0 0 #fff9e6;
                    transform: rotate(-10deg);
                    filter: drop-shadow(0 0 15px #ffd700);
                    z-index: 0;  /* Behind all content */
                    opacity: 0.8;
                    pointer-events: none;
                }

                /* Mobile adjustments for crescent */
                @media (max-width: 768px) {
                    .crescent-moon {
                        top: 20px;
                        left: 3%;
                        width: 80px;
                        height: 80px;
                        box-shadow: -12px 8px 0 0 #fff9e6;
                        opacity: 0.6;
                    }
                }

                /* ===== FANOUS CONTAINER - BACKGROUND DECORATIONS ===== */
                .fanous-container {
                    position: absolute;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    transform-origin: top center;
                    z-index: 1;  /* Above stars, below content */
                    filter: drop-shadow(0 5px 5px rgba(0,0,0,0.4));
                    pointer-events: none;  /* Allow clicks to pass through */
                }

                /* Chain - thin bronze links */
                .fanous-chain {
                    width: 3px;
                    height: 100px;
                    background: repeating-linear-gradient(45deg, #b8860b 0px 3px, #8b6913 3px 6px);
                    box-shadow: 0 0 5px #b8860b;
                }

                /* The lantern image - connected directly to chain */
                .fanous-image {
                    display: block;
                    max-width: 120px;
                    height: auto;
                    margin-top: 0px;
                    filter: drop-shadow(0 3px 6px rgba(0,0,0,0.4));
                    transition: filter 0.3s ease;
                    pointer-events: none;  /* Allow clicks to pass through */
                }

                /* Desktop lamp positions */
                .lamp-1 { left: 3%; top: 12%; animation: gentleSwing 3.5s infinite ease-in-out; }
                .lamp-2 { left: 18%; top: 28%; animation: gentleSwing 4s infinite ease-in-out; }
                .lamp-3 { right: 5%; top: 18%; animation: gentleSwing 3.8s infinite ease-in-out; }
                .lamp-4 { right: 18%; top: 32%; animation: gentleSwing 4.2s infinite ease-in-out; }

                /* Mobile: only 2 lanterns, smaller, repositioned */
                @media (max-width: 768px) {
                    .lamp-1, .lamp-4 { display: flex; }
                    .lamp-2, .lamp-3 { display: none; }
                    
                    .lamp-1 { left: 2%; top: 15%; }
                    .lamp-4 { right: 2%; top: 25%; }
                    
                    .fanous-chain {
                        height: 70px;
                        width: 2px;
                    }
                    
                    .fanous-image {
                        max-width: 70px;
                    }
                }

                @keyframes gentleSwing {
                    0%, 100% { transform: rotate(-1.5deg); }
                    50% { transform: rotate(1.5deg); }
                }

                /* ===== MUSIC PLAYER PANEL - SIDEBAR UI ===== */
                .music-player-panel {
                    position: fixed;
                    top: 50%;
                    right: -280px;
                    transform: translateY(-50%);
                    display: flex;
                    align-items: center;
                    z-index: 1000;  /* Higher than most UI, but still behind modals */
                    transition: right 0.6s ease;
                }
                .music-player-panel.open { right: 0; }

                .panel-toggle {
                    width: 40px;
                    height: 120px;
                    background: linear-gradient(135deg, #d4af37, #b8860b);
                    color: #020d0b;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    cursor: pointer;
                    border-radius: 15px 0 0 15px;
                    box-shadow: -3px 0 10px rgba(0,0,0,0.4);
                    border: 1px solid #ffcc33;
                    border-right: none;
                    font-size: 22px;
                    z-index: 1001;
                    pointer-events: auto;  /* This should be clickable */
                }

                .panel-content {
                    width: 280px;
                    background: rgba(8, 20, 15, 0.95);
                    backdrop-filter: blur(10px);
                    padding: 20px;
                    border-left: 2px solid #d4af37;
                    box-shadow: -8px 0 25px rgba(0,0,0,0.5);
                    z-index: 1000;
                    pointer-events: auto;  /* This should be clickable */
                }

                /* Mobile music panel adjustments */
                @media (max-width: 768px) {
                    .music-player-panel {
                        right: -240px;
                    }
                    
                    .panel-content {
                        width: 240px;
                        padding: 15px;
                    }
                    
                    .panel-toggle {
                        width: 35px;
                        height: 100px;
                        font-size: 20px;
                    }
                    
                    .play-pause-btn {
                        width: 40px;
                        height: 40px;
                    }
                }

                .play-pause-btn {
                    background: #d4af37;
                    border: none;
                    border-radius: 50%;
                    width: 45px;
                    height: 45px;
                    cursor: pointer;
                    color: #020d0b;
                    box-shadow: 0 3px 6px rgba(0,0,0,0.3);
                    transition: transform 0.2s ease;
                    pointer-events: auto;
                }
                .play-pause-btn:hover { transform: scale(1.1); background: #ffcc33; }

                .seek-slider { 
                    flex: 1; 
                    accent-color: #d4af37; 
                    cursor: pointer; 
                    height: 5px;
                    pointer-events: auto;
                }

                /* Transparent content area - normal flow */
                #wrap {
                    position: relative;
                    z-index: 10;  /* Above decorations */
                    background: transparent !important;
                    border-radius: 20px;
                    margin: 15px;
                    padding: 15px;
                }

                /* Ensure navbar and hamburger menu stay on top */
                .navbar, header, .o_main_navbar, .o_menu_sections, .o_menu_toggle {
                    position: relative;
                    z-index: 100 !important;  /* Above decorations, below music panel */
                }

                /* Ensure form fields and interactive elements are above decorations */
                input, textarea, select, .btn, a, .o_dropdown, .modal, .dropdown-menu {
                    position: relative;
                    z-index: 50;  /* Above decorations */
                }

                /* Make sure modals and popups are above everything */
                .modal, .modal-content, .popover, .tooltip {
                    z-index: 2000 !important;  /* Above music panel */
                }

                /* Mobile navbar fixes */
                @media (max-width: 768px) {
                    .navbar-brand, .o_menu_toggle {
                        z-index: 101 !important;
                    }
                    
                    /* Ensure mobile menu dropdown appears above everything */
                    .o_menu_sections {
                        z-index: 102 !important;
                    }
                }

                /* Make sure dropdowns are clickable */
                .dropdown-menu, .o_dropdown_menu {
                    pointer-events: auto !important;
                    z-index: 1000 !important;
                }

                /* Ensure all Odoo content is above decorations */
                .o_website_apps, .o_website_sale, .o_blog, .o_portal, .o_forum {
                    position: relative;
                    z-index: 15;
                }
                ]]>
            </style>
        </xpath>

        <xpath expr="//body" position="inside">
            <!-- Starry Sky - Lowest layer -->
            <div class="starfield" id="starfield"></div>

            <!-- Single Crescent - Low layer -->
            <div class="crescent-moon"></div>

            <!-- Lanterns - Low layer, non-interactive -->
            <div class="fanous-container lamp-1">
                <div class="fanous-chain" style="height:120px;"></div>
                <img class="fanous-image" src="/ramadan_ux_design/static/description/fanoos.png" alt="Ramadan Lantern" style="margin-top: 0;"/>
            </div>

            <div class="fanous-container lamp-2">
                <div class="fanous-chain" style="height:150px;"></div>
                <img class="fanous-image" src="/ramadan_ux_design/static/description/fanoos.png" alt="Ramadan Lantern" style="margin-top: 0;"/>
            </div>

            <div class="fanous-container lamp-3">
                <div class="fanous-chain" style="height:100px;"></div>
                <img class="fanous-image" src="/ramadan_ux_design/static/description/fanoos.png" alt="Ramadan Lantern" style="margin-top: 0;"/>
            </div>

            <div class="fanous-container lamp-4">
                <div class="fanous-chain" style="height:140px;"></div>
                <img class="fanous-image" src="/ramadan_ux_design/static/description/fanoos.png" alt="Ramadan Lantern" style="margin-top: 0;"/>
            </div>

            <!-- Music Panel - High layer, interactive -->
            <div class="music-player-panel" id="musicPlayerPanel">
                <div class="panel-toggle" id="panelToggle">
                    <span id="toggleIcon">♬</span>
                </div>
                <div class="panel-content">
                    <h5 style="text-align:center; color:#d4af37; margin-bottom:15px; font-size:16px;">🌙 RAMADAN KAREEM</h5>
                    <div style="display:flex; align-items:center; gap:12px;">
                        <button class="play-pause-btn" id="playPauseBtn">
                            <i class="fa fa-play"></i>
                        </button>
                        <input type="range" class="seek-slider" id="seekSlider" value="0" step="0.1" min="0"/>
                    </div>
                    <audio id="ramadanSong" loop="loop" preload="auto">
                        <source src="/ramadan_ux_design/static/description/song.mp3" type="audio/mpeg"/>
                    </audio>
                </div>
            </div>
        </xpath>

        <xpath expr="//body" position="after">
            <script type="text/javascript">
                <![CDATA[
                document.addEventListener('DOMContentLoaded', function() {
                    // Stars generation - responsive count
                    const starfield = document.getElementById('starfield');
                    const isMobile = window.innerWidth <= 768;
                    
                    if (starfield) {
                        starfield.innerHTML = '';
                        
                        // Fewer stars on mobile for performance
                        const starCount = isMobile ? 150 : 300;
                        
                        for (let i = 0; i < starCount; i++) {
                            const star = document.createElement('div');
                            star.className = 'star';
                            
                            const r = Math.random();
                            if (r < 0.6) star.classList.add('small');
                            else if (r < 0.9) star.classList.add('medium');
                            else star.classList.add('large');
                            
                            star.style.left = Math.random() * 100 + '%';
                            star.style.top = (Math.random() * 20 - 10) + '%';
                            
                            // Slightly faster on mobile for performance/look
                            const duration = isMobile ? 3 + Math.random() * 3 : 4 + Math.random() * 4;
                            star.style.animation = `fallDown ${duration}s linear infinite`;
                            
                            star.style.animationDelay = (Math.random() * 5) + 's';
                            
                            starfield.appendChild(star);
                        }
                    }

                    // Music player with autoplay after first interaction
                    const panel = document.getElementById('musicPlayerPanel');
                    const toggle = document.getElementById('panelToggle');
                    const audio = document.getElementById('ramadanSong');
                    const btn = document.getElementById('playPauseBtn');
                    const slider = document.getElementById('seekSlider');
                    
                    let userInteracted = false;
                    
                    // Function to attempt autoplay after user interaction
                    function enableAutoplay() {
                        if (!userInteracted) {
                            userInteracted = true;
                            
                            // Try to play if panel is open or was previously playing
                            if (panel.classList.contains('open')) {
                                audio.play().catch(e => console.log("Autoplay prevented:", e));
                            }
                            
                            // Remove listeners after first interaction
                            document.removeEventListener('click', enableAutoplay);
                            document.removeEventListener('touchstart', enableAutoplay);
                            document.removeEventListener('scroll', enableAutoplay);
                        }
                    }
                    
                    // Listen for first user interaction
                    document.addEventListener('click', enableAutoplay, { once: true });
                    document.addEventListener('touchstart', enableAutoplay, { once: true });
                    document.addEventListener('scroll', enableAutoplay, { once: true });

                    toggle.addEventListener('click', (e) => {
                        e.stopPropagation();
                        panel.classList.toggle('open');
                        
                        // If panel opens and user has interacted, try to play
                        if (panel.classList.contains('open') && userInteracted && audio.paused) {
                            audio.play().catch(e => console.log("Play failed:", e));
                            btn.innerHTML = '<i class="fa fa-pause"></i>';
                        }
                    });

                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (audio.paused) {
                            audio.play().catch(e => console.log("Play blocked"));
                            btn.innerHTML = '<i class="fa fa-pause"></i>';
                        } else {
                            audio.pause();
                            btn.innerHTML = '<i class="fa fa-play"></i>';
                        }
                    });

                    audio.addEventListener('timeupdate', () => {
                        if (!isNaN(audio.duration)) {
                            slider.max = audio.duration;
                            slider.value = audio.currentTime;
                        }
                    });

                    slider.addEventListener('input', () => {
                        audio.currentTime = slider.value;
                    });
                    
                    // Handle page navigation - maintain play state if possible
                    window.addEventListener('beforeunload', function() {
                        if (!audio.paused) {
                            sessionStorage.setItem('ramadanMusicPlaying', 'true');
                        } else {
                            sessionStorage.setItem('ramadanMusicPlaying', 'false');
                        }
                    });
                    
                    // Check if music was playing before navigation
                    if (sessionStorage.getItem('ramadanMusicPlaying') === 'true') {
                        // Will play after user interaction via the enableAutoplay function
                        console.log("Music was playing, will resume after interaction");
                    }
                });
                ]]>
            </script>
        </xpath>
    </template>
</odoo>
